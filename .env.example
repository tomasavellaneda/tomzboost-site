# Copiá este archivo a .env y completá los valores. No subas el .env.

# Secret de 40 caracteres que entrega BuckPay.
BUCKPAY_TOKEN=
# Header User-Agent que te pasa el gerente de cuentas.
BUCKPAY_USER_AGENT=
BUCKPAY_API_BASE=https://api.realtechdev.com.br

# URL pública del sitio, sin barra final. Activa el webhook de pago.
PUBLIC_BASE_URL=

# Precio de la optimización completa, en centavos. Por defecto 18000 (R$ 180,00).
BOOKING_AMOUNT_CENTS=18000
# Slug de la oferta en el panel de Buck. Vacío si todavía no existe.
BOOKING_OFFER_SLUG=

# Agenda. Días 1=lunes … 7=domingo.
SCHEDULE_TZ=America/Sao_Paulo
SCHEDULE_DAYS=1,2,3,4,5,6
SCHEDULE_START=14:00
SCHEDULE_END=22:00
SLOT_MINUTES=60
HOLD_MINUTES=20
LEAD_HOURS=3
HORIZON_DAYS=14

# 1 solo en local. Simula el PIX y no llama a BuckPay.
BUCKPAY_MOCK=0
